@@ -456,6 +459,13 @@
 
           cp -R data "$package_dir/"
 
+          # Legal notices must travel with every binary and with data/.
+          cp LICENSE LICENSE-CONTENT NOTICE THIRD-PARTY-NOTICES TRADEMARKS.md \
